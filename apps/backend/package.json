{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "exports": {
    "./content-status": {
      "types": "./src/content/content.schema.ts",
      "import": "./src/content/content.schema.ts",
      "default": "./src/content/content.schema.ts"
    }
  },
  "scripts": {
    "build": "nest build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix --deny-warnings .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "trpc:chmod": "chmod +x node_modules/nestjs-trpc/native/**/*",
    "trpc:generate": "cd ../.. && nestjs-trpc generate --output packages/trpc/src/server/server.ts --entrypoint apps/backend/src/main.ts",
    "trpc:watch": "sleep 3 && cd ../.. && nestjs-trpc watch --output packages/trpc/src/server/server.ts --entrypoint apps/backend/src/main.ts",
    "postinstall": "pnpm run trpc:chmod",
    "dev": "nest start --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/lib-storage": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@credenza3/contracts": "^0.0.21",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@nullix/zod-mongoose": "^3.0.0",
    "@repo/notifications": "workspace:*",
    "@trpc/server": "^11.18.0",
    "body-parser": "^2.3.0",
    "es-toolkit": "^1.52.0",
    "ethers": "^6.17.0",
    "jose": "^6.2.10",
    "luxon": "^3.7.2",
    "mime-types": "^3.0.2",
    "mongoose": "9.9.4",
    "nestjs-trpc": "^2.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "trpc-ui-zod4": "^1.1.0",
    "ws": "^8.21.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/luxon": "^3.7.5",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "jest": "^30.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "jest": {
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "rootDir": "src",
    "testEnvironment": "node",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "tsconfig.json"
        }
      ]
    }
  }
}
