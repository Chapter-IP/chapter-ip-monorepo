{
  "name": "frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "lint:fix": "oxlint --type-aware --fix --deny-warnings .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run"
  },
  "dependencies": {
    "@credenza3/contracts": "^0.0.21",
    "@credenza3/passport-evm": "^0.4.38",
    "@tailwindcss/vite": "^4.3.3",
    "client-zip": "^2.5.1",
    "daisyui": "^5.7.50",
    "mime": "^4.1.1",
    "native-file-system-adapter": "^3.0.1",
    "svelte-modals": "^2.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@repo/content-types": "workspace:*",
    "@repo/fe-auth": "workspace:*",
    "@repo/fe-config": "workspace:*",
    "@repo/fe-evm-provider": "workspace:*",
    "@repo/fe-services": "workspace:*",
    "@repo/trpc": "workspace:*",
    "@repo/ui-components": "workspace:*",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@vitest/browser": "^5.0.4",
    "@vitest/browser-playwright": "^5.0.4",
    "playwright": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vitest-browser-svelte": "^3.1.0",
    "yaml": "^2.9.1"
  }
}
