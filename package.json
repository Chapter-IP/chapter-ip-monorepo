{
  "name": "chapter-ip-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "trpc:generate": "turbo run trpc:generate --filter=backend",
    "trpc:watch": "turbo run trpc:watch --filter=backend",
    "check-types": "turbo run check-types",
    "ncu": "pnpm dlx npm-check-updates --deep -i",
    "prepare": "[ -n \"$RAILWAY_ENVIRONMENT_ID\" ] || lefthook install"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@^7.0.2",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
