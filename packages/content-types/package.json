{
  "name": "@repo/content-types",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./content": {
      "types": "./src/content.ts",
      "import": "./src/content.ts",
      "default": "./src/content.ts"
    },
    "./likeness": {
      "types": "./src/likeness.ts",
      "import": "./src/likeness.ts",
      "default": "./src/likeness.ts"
    },
    "./location": {
      "types": "./src/location.ts",
      "import": "./src/location.ts",
      "default": "./src/location.ts"
    },
    "./works": {
      "types": "./src/works.ts",
      "import": "./src/works.ts",
      "default": "./src/works.ts"
    }
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings ."
  },
  "dependencies": {
    "@repo/trpc": "workspace:*"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
